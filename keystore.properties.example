# Copy this file to keystore.properties and fill in your signing details.
# NEVER commit keystore.properties or your keystore file to a public repo.
# For a PKCS12 keystore (the keytool default) keyPassword must be the same as storePassword.
storeFile=../gitdrop.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=gitdrop
keyPassword=YOUR_KEY_PASSWORD
