<resources>
    <string name="app_name">GitDrop</string>
    <string name="tagline">把手机里的文件和文件夹上传到 GitHub。</string>
    <string name="step1">第 1 步，共 3 步 · 连接 GitHub</string>
    <string name="step1_expl">粘贴一个有权写入你的仓库的 GitHub 个人访问令牌：可以是具有“repo”权限的经典令牌，或具有“Contents: Read and write”权限的细粒度（fine-grained）令牌。令牌只保存在内存中，仅通过 HTTPS 发送到 api.github.com，关闭应用后即被丢弃。</string>
    <string name="create_token">在 GitHub 上创建令牌</string>
