<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.1+: the navigation bar is white, so ask for dark navigation icons (older versions keep a black bar). -->
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/navy</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
